        <Setter Property="Template"><Setter.Value>
            <ControlTemplate TargetType="RadioButton">
                <Grid Background="Transparent">
                    <Border x:Name="Hover" CornerRadius="24" Margin="0,0,10,0" Background="Transparent" />

                    <StackPanel Orientation="Horizontal" Margin="8,0,12,0" VerticalAlignment="Center">
                        <Border x:Name="IconSurface" Width="34" Height="34" CornerRadius="17" Background="#0AFFFFFF" RenderTransformOrigin=".5,.5">

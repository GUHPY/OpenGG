                        </Border>
                        <ContentPresenter x:Name="NavLabel" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="ctl:Ui.Compact" Value="True">
                        <Setter TargetName="NavLabel" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Hover" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="IconSurface" Property="Background" Value="Transparent" />

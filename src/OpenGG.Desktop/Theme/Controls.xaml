                    <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="Hover" Property="Opacity" Value="0" />
                        <Setter TargetName="IconSurface" Property="Background" Value="#F4F4F6" />
                        <Setter TargetName="Ico" Property="Foreground" Value="#101012" />
